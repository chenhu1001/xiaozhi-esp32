{
    "manufacturer": "lckfb",
    "type": "lichuang-dev",
    "target": "esp32s3",
    "builds": [
        {
            "name": "lichuang-dev",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y"
            ]
        },
        {
            "name": "lichuang-dev-ancs",
            "sdkconfig_append": [
                "CONFIG_USE_DEVICE_AEC=y",
                "CONFIG_ENABLE_IOS_ANCS_RELAY=y",
                "CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=y",
                "CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n",
                "CONFIG_BT_ENABLED=y",
                "CONFIG_BT_BLUEDROID_ENABLED=n",
                "CONFIG_BT_NIMBLE_ENABLED=y",
                "CONFIG_BT_CONTROLLER_ENABLED=y",
                "CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_INTERNAL=n",
                "CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y",
                "CONFIG_BT_NIMBLE_ROLE_CENTRAL=y",
                "CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y",
                "CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y",
                "CONFIG_BT_NIMBLE_ROLE_OBSERVER=n",
                "CONFIG_BT_NIMBLE_GATT_CLIENT=y",
                "CONFIG_BT_NIMBLE_GATT_SERVER=y",
                "CONFIG_BT_NIMBLE_SECURITY_ENABLE=y",
                "CONFIG_BT_NIMBLE_SM_SC=y",
                "CONFIG_BT_NIMBLE_NVS_PERSIST=y",
                "CONFIG_BT_NIMBLE_MAX_BONDS=1",
                "CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1",
                "CONFIG_BT_NIMBLE_EXTRA_ADV_FIELDS=y",
                "CONFIG_BT_NIMBLE_DIS_SERVICE=y",
                "CONFIG_BT_NIMBLE_SVC_DIS_MANUFACTURER_NAME=y",
                "CONFIG_BT_NIMBLE_SVC_DIS_FIRMWARE_REVISION=y"
            ]
        }
    ]
}
